---
interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;
---

<!-- Left Vertical HUD Guideline with triple primary chevron arrows -->
<div class="pointer-events-none fixed left-8 lg:left-14 top-20 bottom-24 z-30 hidden w-px bg-muted-foreground/30 lg:block"></div>
<div class="pointer-events-none fixed left-8 lg:left-14 top-20 z-40 hidden -translate-x-1/2 flex-col items-center gap-1 lg:flex">
  <span class="size-0 border-x-[5px] border-b-8 border-x-transparent border-b-primary animate-pulse"></span>
  <span class="size-0 border-x-[5px] border-b-8 border-x-transparent border-b-primary opacity-70"></span>
  <span class="size-0 border-x-[5px] border-b-8 border-x-transparent border-b-primary opacity-40"></span>
</div>

<!-- Top-Left Menu Trigger Button -->
<div class="fixed left-4 top-4 z-50 lg:left-10 lg:top-7">
  <button
    id="menu-toggle-btn"
    type="button"
    aria-label="Abrir menú de navegación"
    class="flex size-10 items-center justify-center rounded-lg border border-border bg-card/80 text-foreground backdrop-blur-md transition-all hover:border-primary/60 hover:bg-card shadow-sm hover:shadow-primary/20 cursor-pointer"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <line x1="4" x2="20" y1="12" y2="12"></line>
      <line x1="4" x2="20" y1="6" y2="6"></line>
      <line x1="4" x2="20" y1="18" y2="18"></line>
    </svg>
  </button>
</div>

<!-- Top-Right Controls: Language Toggle & Theme Toggle -->
<div class="fixed right-4 top-4 z-50 flex items-center gap-2 rounded-full border border-border bg-card/80 px-2 py-1.5 backdrop-blur-md shadow-sm lg:right-10 lg:top-7">
  <!-- Language Toggle Button -->
  <button
    id="lang-toggle-btn"
    type="button"
    aria-label="Cambiar idioma / Switch language"
    class="flex items-center gap-1.5 rounded-full px-2.5 py-1 text-xs font-mono font-medium text-foreground transition-colors hover:text-primary hover:bg-secondary cursor-pointer"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="10"></circle>
      <line x1="2" x2="22" y1="12" y2="12"></line>
      <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
    </svg>
    <span id="lang-current-label" class="tracking-wider uppercase">{currentLang}</span>
  </button>

  <span class="h-3.5 w-px bg-border"></span>

  <!-- Theme Toggle Button -->
  <button
    id="theme-toggle-btn"
    type="button"
    aria-label="Alternar tema oscuro / claro"
    class="flex size-7 items-center justify-center rounded-full text-foreground transition-colors hover:text-primary hover:bg-secondary cursor-pointer"
  >
    <!-- Sun Icon (shows in dark mode) -->
    <svg id="theme-sun-icon" class="size-4 hidden dark:block" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="12" cy="12" r="4"></circle>
      <path d="M12 2v2"></path>
      <path d="M12 20v2"></path>
      <path d="m4.93 4.93 1.41 1.41"></path>
      <path d="m17.66 17.66 1.41 1.41"></path>
      <path d="M2 12h2"></path>
      <path d="M20 12h2"></path>
      <path d="m6.34 17.66-1.41 1.41"></path>
      <path d="m19.07 4.93-1.41 1.41"></path>
    </svg>
    <!-- Moon Icon (shows in light mode) -->
    <svg id="theme-moon-icon" class="size-4 block dark:hidden" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
    </svg>
  </button>
</div>

<!-- Bottom-Left Floating Player Card Pill (Enlarged, Clear Photo, Name & Title) -->
<div class="fixed bottom-6 left-4 lg:left-8 z-40">
  <button
    id="player-card-trigger"
    type="button"
    aria-label="Abrir ficha técnica y CV de Axell Rojas"
    class="group flex items-center gap-3.5 rounded-full border border-border/80 bg-card/95 py-2 px-3 sm:py-2.5 sm:px-4 backdrop-blur-xl shadow-xl shadow-black/20 transition-all hover:scale-[1.03] hover:border-primary/70 cursor-pointer"
  >
    <!-- Photo: Full view of face without overlapping dots -->
    <div class="relative size-11 sm:size-12 overflow-hidden rounded-full border-2 border-primary/50 shadow-md bg-muted shrink-0">
      <img
        src="/images/avatar.jpg"
        alt="Axell Rojas"
        class="size-full object-cover object-top"
      />
    </div>
    
    <!-- Info: Name & IT Infrastructure Specialist -->
    <div class="flex flex-col text-left pr-1.5">
      <div class="flex items-center gap-2">
        <span class="font-extrabold text-sm sm:text-base text-foreground group-hover:text-primary transition-colors leading-snug">
          Axell Rojas
        </span>
        <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
      </div>
      <span class="font-mono text-xs text-primary font-medium tracking-tight">
        IT Infrastructure Specialist
      </span>
    </div>
  </button>
</div>

<script>
  const themeToggle = document.getElementById('theme-toggle-btn');
  themeToggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });

  const langToggle = document.getElementById('lang-toggle-btn');
  langToggle?.addEventListener('click', () => {
    const currentLang = document.documentElement.getAttribute('lang') || 'es';
    const nextLang = currentLang === 'es' ? 'en' : 'es';
    window.dispatchEvent(new CustomEvent('toggle-language', { detail: { lang: nextLang } }));
  });
</script>
