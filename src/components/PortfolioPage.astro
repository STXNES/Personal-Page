---
import Layout from '../layouts/Layout.astro';
import Navbar from './Navbar.astro';
import Hero from './Hero.astro';
import SelectedWork from './SelectedWork.astro';
import Experience from './Experience.astro';
import Terminal from './Terminal.astro';
import TechStack from './TechStack.astro';
import Certifications from './Certifications.astro';
import About from './About.astro';
import Footer from './Footer.astro';
import PlayerCardModal from './PlayerCardModal.astro';
import ProjectModal from './ProjectModal.astro';
import { portfolioData } from '../data/portfolioData';

interface Props {
  lang?: 'en' | 'es';
}

const { lang = 'es' } = Astro.props;
const data = portfolioData[lang];

const pageTitle = lang === 'en'
  ? "Axell Rojas — Systems & Cloud Infrastructure Specialist"
  : "Axell Rojas — Especialista en Sistemas, Infraestructura Cloud & Automatización";

const pageDesc = lang === 'en'
  ? "Systems Engineer & Infrastructure Specialist. Windows Server 2022 AD DS, Linux Hardening (CIS L2), DevOps pipelines, and 2+ years of critical 24/7 manufacturing operations at Intel Corporation."
  : "Ingeniero de Sistemas y Especialista en Infraestructura. Windows Server 2022 AD DS, Endurecimiento Linux (CIS L2), pipelines DevOps y 2+ años de operaciones críticas 24/7 en Intel Corporation.";
---

<Layout title={pageTitle} description={pageDesc} lang={lang}>
  <!-- Sticky Frosted Glass Top Navigation -->
  <Navbar currentLang={lang} />

  <!-- Interactive Architecture & Dossier Modals -->
  <ProjectModal currentLang={lang} />
  <PlayerCardModal currentLang={lang} />

  <!-- Main Content Stream Container (Executive Bento Layout) -->
  <main class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8 sm:space-y-12">
    <Hero currentLang={lang} />
    <SelectedWork currentLang={lang} />
    <Experience currentLang={lang} />
    <Terminal currentLang={lang} />
    <TechStack currentLang={lang} />
    <Certifications currentLang={lang} />
    <About currentLang={lang} />
  </main>

  <!-- Systems Footer -->
  <Footer currentLang={lang} />
</Layout>
