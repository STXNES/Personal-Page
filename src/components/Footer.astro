---
import { portfolioData } from '../data/portfolioData';

interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;
const data = portfolioData[currentLang];
---

<footer class="relative border-t border-border bg-card/40 py-10 backdrop-blur-sm">
  <div class="relative mx-auto max-w-7xl px-6 lg:px-16">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6">
      
      <!-- Left: Brand & Status -->
      <div class="flex flex-col items-center md:items-start text-center md:text-left">
        <div class="flex items-center gap-2">
          <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span class="font-mono text-xs font-bold tracking-widest text-foreground">AXELL ROJAS</span>
          <span class="text-xs text-muted-foreground">·</span>
          <span class="font-mono text-xs text-primary">IT INFRASTRUCTURE SPECIALIST</span>
        </div>
        <p class="font-mono text-[11px] text-muted-foreground mt-1">
          {data.footer.copyright}
        </p>
      </div>

      <!-- Center: Section Shortcuts -->
      <div class="flex flex-wrap items-center justify-center gap-4 text-xs font-mono text-muted-foreground">
        <a href="#top" class="hover:text-primary transition-colors">Hero</a>
        <span>/</span>
        <a href="#work" class="hover:text-primary transition-colors">{data.nav.work}</a>
        <span>/</span>
        <a href="#experience" class="hover:text-primary transition-colors">{data.nav.experience}</a>
        <span>/</span>
        <a href="#stack" class="hover:text-primary transition-colors">{data.nav.stack}</a>
        <span>/</span>
        <a href="#certifications" class="hover:text-primary transition-colors">{data.nav.certifications}</a>
        <span>/</span>
        <a href="#about" class="hover:text-primary transition-colors">{data.nav.about}</a>
      </div>

      <!-- Right: Social Links -->
      <div class="flex items-center gap-3">
        <a
          href="https://github.com/STXNES"
          target="_blank"
          rel="noopener noreferrer"
          class="size-8 rounded-lg border border-border flex items-center justify-center text-muted-foreground hover:text-foreground hover:border-primary/50 transition-colors"
          aria-label="GitHub"
        >
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
            <path d="M9 18c-4.51 2-5-2-7-2"></path>
          </svg>
        </a>

        <a
          href="https://linkedin.com/in/axro"
          target="_blank"
          rel="noopener noreferrer"
          class="size-8 rounded-lg border border-border flex items-center justify-center text-muted-foreground hover:text-foreground hover:border-primary/50 transition-colors"
          aria-label="LinkedIn"
        >
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
            <rect width="4" height="12" x="2" y="9"></rect>
            <circle cx="4" cy="4" r="2"></circle>
          </svg>
        </a>

        <a
          href="mailto:axelry2402@gmail.com"
          class="size-8 rounded-lg border border-border flex items-center justify-center text-muted-foreground hover:text-foreground hover:border-primary/50 transition-colors"
          aria-label="Email"
        >
          <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="20" height="16" x="2" y="4" rx="2"></rect>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
          </svg>
        </a>
      </div>

    </div>
  </div>
</footer>
