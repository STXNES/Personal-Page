---
import { portfolioData } from '../data/portfolioData';

interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;
const data = portfolioData[currentLang];
const isEn = currentLang === 'en';

const kLabel = isEn ? "Professional Profile & Engineering Ethos" : "Perfil Profesional & Metodología";
const kTitle = isEn
  ? "Discipline from Mission-Critical Tech, Vision for Autonomous Systems"
  : "Disciplina en Operaciones Críticas, Visión en Sistemas Autónomos";
---

<section id="about" class="relative scroll-mt-24 py-12 border-b border-slate-800/80 space-y-8">
  <!-- Section Kicker Header -->
  <div class="border-b border-slate-800/80 pb-6">
    <span class="text-cyan-400 font-mono text-xs uppercase tracking-wider">{data.about.label}</span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-1 tracking-tight">{kTitle}</h2>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-stretch">
    <!-- Left Column: Bio Narrative (7 cols) -->
    <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
      <div class="space-y-4">
        <p class="text-base sm:text-lg leading-relaxed text-slate-300 font-normal">
          {data.about.p1}
        </p>

        <p class="text-sm sm:text-base leading-relaxed text-slate-400 font-normal">
          {data.about.p2}
        </p>
      </div>

      <!-- Languages & Location Cards -->
      <div class="pt-6 border-t border-slate-800/80 grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div class="glass-card p-4 rounded-xl space-y-1">
          <span class="font-mono text-[10px] text-cyan-400 uppercase tracking-wider">IDIOMAS / LANGUAGES</span>
          <p class="font-semibold text-xs text-white">Spanish: <span class="font-normal text-slate-400">Nativo</span> · English: <span class="font-normal text-slate-400">B1 (Technical)</span></p>
        </div>

        <div class="glass-card p-4 rounded-xl space-y-1">
          <span class="font-mono text-[10px] text-cyan-400 uppercase tracking-wider">UBICACIÓN / LOCATION</span>
          <p class="font-semibold text-xs text-white">Alajuela, Costa Rica <span class="font-normal text-slate-400">· Remoto / Híbrido</span></p>
        </div>
      </div>
    </div>

    <!-- Right Column: Interactive Dossier Trigger Card (5 cols) -->
    <div class="lg:col-span-5 flex flex-col">
      <button
        id="open-dossier-about"
        type="button"
        class="glass-card group w-full h-full rounded-2xl p-6 sm:p-8 flex flex-col justify-between text-left border-cyan-500/30 hover:border-cyan-400 transition-all cursor-pointer relative overflow-hidden"
      >
        <div class="pointer-events-none absolute -right-10 -top-10 size-48 rounded-full bg-cyan-500/10 blur-2xl group-hover:bg-cyan-500/20 transition-all"></div>

        <div>
          <div class="flex items-center justify-between">
            <span class="font-mono text-[10px] font-bold tracking-widest text-cyan-400 uppercase border border-cyan-500/30 px-3 py-1 rounded-full bg-cyan-500/10">
              SYSADMIN DOSSIER
            </span>
            <span class="font-mono text-xs text-slate-500">ID: AR-9924</span>
          </div>

          <h3 class="mt-4 text-2xl font-bold text-white group-hover:text-cyan-400 transition-colors">
            {isEn ? "Open Technical Candidate Dossier" : "Abrir Dossier Técnico del Candidato"}
          </h3>
          <p class="mt-2 text-xs text-slate-400 leading-relaxed">
            {isEn
              ? "Interactive telemetry card detailing core systems proficiencies, operational mindset, shift readiness, and direct contact protocols."
              : "Ficha interactiva con métricas clave de sistemas, mentalidad operativa, disponibilidad de turnos y protocolos de contacto."}
          </p>
        </div>

        <div class="mt-6 pt-4 border-t border-slate-800/80 flex items-center justify-between">
          <span class="font-mono text-xs font-semibold text-cyan-400">
            {isEn ? "Launch Dossier Modal ↗" : "Ver Perfil Extendido ↗"}
          </span>
          <div class="size-8 rounded-lg bg-cyan-500/10 text-cyan-400 border border-cyan-500/30 flex items-center justify-center group-hover:bg-cyan-400 group-hover:text-slate-950 transition-all">
            <svg class="size-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </div>
        </div>
      </button>
    </div>
  </div>
</section>

<script>
  const openAboutDossier = document.getElementById('open-dossier-about');
  openAboutDossier?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-dossier'));
  });
</script>
