---
import { portfolioData } from '../data/portfolioData';

interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;
const data = portfolioData[currentLang];
---

<section id="about" class="relative scroll-mt-20 border-b border-border py-16 sm:py-24">
  <div class="pointer-events-none absolute inset-0 bg-grid opacity-20"></div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-16">
    <!-- Section Kicker Header -->
    <div class="flex items-center gap-3">
      <span class="h-px w-8 bg-primary"></span>
      <span class="font-mono text-xs font-semibold tracking-[0.3em] text-primary uppercase">
        {data.about.label}
      </span>
    </div>

    <!-- Main Grid: items-stretch for 100% Vertical Symmetry -->
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-10 items-stretch">
      
      <!-- Left Column: Bio Narrative (7 cols) -->
      <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
        <div class="space-y-4">
          <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
            Discipline from High-Precision Tech, Vision for Autonomous Systems
          </h2>

          <p class="text-sm sm:text-base leading-relaxed text-muted-foreground font-normal">
            {data.about.p1}
          </p>

          <p class="text-sm sm:text-base leading-relaxed text-muted-foreground font-normal">
            {data.about.p2}
          </p>

          <p class="text-sm sm:text-base leading-relaxed text-muted-foreground font-normal">
            {data.about.p3}
          </p>
        </div>

        <!-- Languages & Location Cards (Bottom of Left Column) -->
        <div class="pt-6 border-t border-border grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="h-[76px] p-3.5 rounded-xl border border-border bg-card/50 flex flex-col justify-between">
            <span class="font-mono text-[10px] text-muted-foreground uppercase">IDIOMAS / LANGUAGES</span>
            <div>
              <p class="font-semibold text-xs text-foreground">Spanish: <span class="font-normal text-muted-foreground">Nativo</span> · English: <span class="font-normal text-muted-foreground">B1 (Technical)</span></p>
            </div>
          </div>

          <div class="h-[76px] p-3.5 rounded-xl border border-border bg-card/50 flex flex-col justify-between">
            <span class="font-mono text-[10px] text-muted-foreground uppercase">UBICACIÓN &amp; DISPONIBILIDAD</span>
            <div>
              <p class="font-semibold text-xs text-foreground">Naranjo, Alajuela, Costa Rica</p>
              <p class="font-mono text-[10px] text-emerald-400 flex items-center gap-1">
                <span class="size-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                On-Site / Híbrido / Remoto
              </p>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Quote Card, Metrics, & Aligned Action Card (5 cols) -->
      <div class="lg:col-span-5 flex flex-col justify-between space-y-4">
        <!-- Quote Box (Removed "Intel Alumni", clean Systems Engineer title) -->
        <div class="brackets relative rounded-2xl border border-primary/40 bg-card/85 p-6 sm:p-7 backdrop-blur-md shadow-lg flex-1 flex flex-col justify-between">
          <div>
            <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" class="text-primary/70">
              <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"></path>
            </svg>

            <p class="mt-3 text-base sm:text-lg font-bold leading-snug text-foreground">
              {data.about.quote}
            </p>
          </div>

          <div class="mt-5 flex items-center gap-3 pt-4 border-t border-border">
            <div class="size-10 rounded-full overflow-hidden border border-primary/50 shrink-0">
              <img src="/images/avatar.jpg" alt="Axell Rojas" class="size-full object-cover" />
            </div>
            <div>
              <p class="font-bold text-xs text-foreground">Axell Rojas</p>
              <p class="font-mono text-[10px] text-primary">Systems Engineer · IT Infrastructure</p>
            </div>
          </div>
        </div>

        <!-- Metrics Cards (3 columns) -->
        <div class="grid grid-cols-3 gap-3">
          {data.about.stats.map((stat) => (
            <div class="rounded-xl border border-border bg-card/50 p-3 text-center flex flex-col justify-center">
              <p class="font-mono text-xl sm:text-2xl font-black text-primary leading-none">{stat.value}</p>
              <p class="font-mono text-[10px] text-muted-foreground mt-1 leading-tight">{stat.label}</p>
            </div>
          ))}
        </div>

        <!-- Aligned Contact Dossier Card Button: Matches bottom height (76px) of left column! -->
        <button
          id="open-dossier-about"
          type="button"
          class="group h-[76px] w-full flex items-center justify-between rounded-xl border border-primary/40 bg-card/90 px-5 py-3 hover:border-primary hover:bg-card hover:shadow-lg hover:shadow-primary/15 transition-all cursor-pointer"
        >
          <div class="text-left">
            <span class="font-mono text-[10px] text-primary uppercase tracking-widest font-semibold">DOSSIER TÉCNICO &amp; CONTACTO</span>
            <p class="font-extrabold text-sm text-foreground group-hover:text-primary transition-colors mt-0.5">
              {data.playerCard.viewProfile}
            </p>
          </div>
          
          <div class="size-9 rounded-lg border border-primary/30 bg-primary/10 flex items-center justify-center text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-all">
            <svg class="size-4 transition-transform group-hover:translate-x-0.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M5 12h14"></path>
              <path d="m12 5 7 7-7 7"></path>
            </svg>
          </div>
        </button>
      </div>

    </div>
  </div>
</section>

<script>
  const openAboutDossier = document.getElementById('open-dossier-about');
  openAboutDossier?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-dossier'));
  });
</script>
