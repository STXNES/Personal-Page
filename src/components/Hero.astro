---
import { portfolioData } from '../data/portfolioData';

interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;
const data = portfolioData[currentLang];
const isEn = currentLang === 'en';

const availabilityText = isEn
  ? "Available for IT Support L2/L3 · SysAdmin · Cloud Infrastructure"
  : "Disponible para Soporte TI L2/L3 · SysAdmin · Infraestructura Cloud";

const cvHref = "/Axell_Rojas_CV.pdf";
---

<section id="hero" class="relative pt-10 sm:pt-16 pb-12 sm:pb-16 border-b border-slate-800/80">
  <!-- Subtle Ambient Glow -->
  <div class="pointer-events-none absolute -top-20 right-1/4 -z-10 h-72 w-72 rounded-full bg-cyan-500/10 blur-3xl"></div>
  <div class="pointer-events-none absolute top-40 -left-10 -z-10 h-64 w-64 rounded-full bg-blue-600/10 blur-3xl"></div>

  <!-- Availability Status Pill -->
  <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-slate-900/90 border border-emerald-500/30 text-emerald-400 text-xs font-mono mb-6 shadow-sm">
    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
    {availabilityText}
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
    <!-- Left Column: Executive Headline & Narrative -->
    <div class="lg:col-span-7 space-y-6">
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15] text-white">
        {isEn ? (
          <>
            Systems, Networks &amp; Cloud Infrastructure with
            <span class="gradient-text block mt-1">Focus on Security &amp; Automation.</span>
          </>
        ) : (
          <>
            Sistemas, Redes e Infraestructura Cloud con
            <span class="gradient-text block mt-1">Enfoque en Seguridad &amp; Automatización.</span>
          </>
        )}
      </h1>

      <p class="text-base sm:text-lg text-slate-300 max-w-2xl leading-relaxed">
        {isEn ? (
          <>
            Specialist in <span class="text-cyan-400 font-medium">Windows Server 2022 &amp; Active Directory</span> administration, <span class="text-cyan-400 font-medium">Linux server hardening (CIS Benchmark L2)</span>, and <span class="text-cyan-400 font-medium">DevOps &amp; Agentic AI (RAG / n8n)</span> pipelines. Trained in 24/7 mission-critical operations under strict SLAs at <strong class="text-white">Intel Corporation</strong>.
          </>
        ) : (
          <>
            Especialista en administración de <span class="text-cyan-400 font-medium">Windows Server 2022 &amp; Active Directory</span>, bastionado de <span class="text-cyan-400 font-medium">servidores Linux (CIS Benchmark L2)</span>, y canalizaciones <span class="text-cyan-400 font-medium">DevOps &amp; IA Agéntica (RAG / n8n)</span>. Formado en operaciones críticas 24/7 bajo estrictos SLAs en <strong class="text-white">Intel Corporation</strong>.
          </>
        )}
      </p>

      <!-- Action Buttons: 100% Symmetrical on Mobile, Classic Flex on Desktop -->
      <div class="flex flex-col sm:flex-row sm:flex-wrap sm:items-center gap-3 pt-2">
        <a
          href="#projects"
          class="w-full sm:w-auto px-6 py-3 rounded-xl bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 font-bold hover:brightness-110 transition shadow-lg shadow-cyan-500/20 flex items-center justify-center gap-2 text-sm text-center"
        >
          {isEn ? "Explore Architecture Labs" : "Explorar Laboratorios de Arquitectura"}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
          </svg>
        </a>

        <!-- Mobile 2-col row: spans identical full width as the button above -->
        <div class="grid grid-cols-2 gap-3 w-full sm:flex sm:w-auto">
          <a
            href="https://www.linkedin.com/in/axro"
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-5 py-3 rounded-xl glass-card font-semibold text-white hover:text-cyan-400 transition flex items-center justify-center gap-2 text-sm"
          >
            <svg class="w-4 h-4 text-cyan-400 fill-current shrink-0" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
            </svg>
            <span>LinkedIn</span>
          </a>

          <a
            href={cvHref}
            download="Axell_Rojas_CV.pdf"
            class="w-full sm:w-auto px-5 py-3 rounded-xl glass-card font-semibold text-slate-300 hover:text-white transition flex items-center justify-center gap-2 text-sm font-mono"
          >
            <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
            </svg>
            <span>CV (PDF)</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Right Column: Profile Identity & 4 Value Metric Cards -->
    <div class="lg:col-span-5 space-y-4">
      <!-- Profile Header Strip -->
      <div class="glass-card rounded-2xl p-4 flex items-center gap-4">
        <div class="relative size-16 shrink-0 rounded-xl overflow-hidden border-2 border-cyan-500/40 shadow-md shadow-cyan-500/20">
          <img
            src="/images/axell.jpg"
            alt="Axell Rojas"
            class="size-full object-cover object-top"
          />
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h3 class="text-white font-bold text-base">Axell Rojas</h3>
            <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-mono font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">
              VERIFIED
            </span>
          </div>
          <p class="text-xs text-slate-400 font-mono mt-0.5">
            {isEn ? "Systems Admin · Cloud & Security" : "Admin de Sistemas · Cloud & Seguridad"}
          </p>
          <p class="text-[11px] text-slate-500 mt-0.5">
            Costa Rica · English / Spanish
          </p>
        </div>
      </div>

      <!-- 4 Value Pillar Cards (2x2 Grid) -->
      <div class="grid grid-cols-2 gap-3">
        <div class="glass-card p-4 rounded-xl space-y-1">
          <span class="text-2xl font-black text-cyan-400 font-mono">2+ {isEn ? "Yrs" : "Años"}</span>
          <div class="text-xs font-semibold text-white">Intel 24/7 Operations</div>
          <div class="text-[11px] text-slate-400 leading-snug">
            {isEn ? "Process control, strict SLAs & L2 resolution." : "Control de procesos, SLA e incidentes L2."}
          </div>
        </div>

        <div class="glass-card p-4 rounded-xl space-y-1">
          <span class="text-2xl font-black text-blue-400 font-mono">CIS L2</span>
          <div class="text-xs font-semibold text-white">Linux Hardening</div>
          <div class="text-[11px] text-slate-400 leading-snug">
            {isEn ? "Debian/RHEL, UFW DROP, Fail2ban, Nginx." : "Debian/RHEL, UFW DROP, Fail2ban, Nginx."}
          </div>
        </div>

        <div class="glass-card p-4 rounded-xl space-y-1">
          <span class="text-2xl font-black text-indigo-400 font-mono">AD DS</span>
          <div class="text-xs font-semibold text-white">Windows Server 2022</div>
          <div class="text-[11px] text-slate-400 leading-snug">
            {isEn ? "AGDLP model, 14-char GPOs, DNS/DHCP." : "Modelo AGDLP, GPOs de 14 chars, DNS/DHCP."}
          </div>
        </div>

        <div class="glass-card p-4 rounded-xl space-y-1">
          <span class="text-2xl font-black text-purple-400 font-mono">CI/CD</span>
          <div class="text-xs font-semibold text-white">DevOps &amp; RAG AI</div>
          <div class="text-[11px] text-slate-400 leading-snug">
            {isEn ? "Serverless cron, n8n, FAISS vector, Docker." : "Pipelines serverless, n8n, FAISS, Docker."}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
