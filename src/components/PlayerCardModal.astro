---
import { portfolioData } from '../data/portfolioData';

interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;
const data = portfolioData[currentLang];

const modalBio = currentLang === 'en'
  ? "IT & Systems Engineering professional specializing in enterprise infrastructure (Windows Server 2022, Active Directory, VMware, Linux) and applied AI engineering (RAG, n8n automation). Disciplined background in 24/7 mission-critical operations at Intel Corporation."
  : "Profesional en Sistemas e Infraestructura TI especializado en infraestructura corporativa (Windows Server 2022, Active Directory, VMware, Linux) e ingeniería de IA aplicada (RAG, automatización n8n). Experiencia en operaciones críticas 24/7 en Intel Corporation.";
---

<div
  id="player-modal-overlay"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/75 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300"
>
  <div
    id="player-modal-card"
    class="brackets relative w-full max-w-xl rounded-2xl border border-border bg-card/95 p-6 sm:p-8 shadow-2xl backdrop-blur-xl transform scale-95 transition-transform duration-300"
  >
    <!-- Modal Close Button -->
    <button
      id="close-player-modal"
      type="button"
      aria-label="Cerrar ficha"
      class="absolute right-5 top-5 size-8 flex items-center justify-center rounded-lg border border-border text-muted-foreground hover:text-foreground hover:border-primary/50 transition-colors cursor-pointer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Top Badge Header -->
    <div class="flex items-center gap-2 mb-6">
      <span class="size-2 rounded-full bg-emerald-500 animate-pulse"></span>
      <span class="font-mono text-[11px] font-bold tracking-[0.25em] text-emerald-400 uppercase">
        {data.playerCard.statusText}
      </span>
    </div>

    <!-- Main Profile Info: 100% Symmetrical Photo & Info Heights -->
    <div class="flex flex-col sm:flex-row gap-5 items-stretch">
      <!-- Portrait Photo Container -->
      <div class="relative shrink-0 w-28 h-36 sm:w-32 sm:h-36 rounded-2xl overflow-hidden border-2 border-primary/50 shadow-lg shadow-primary/20 bg-muted mx-auto sm:mx-0">
        <img
          src="/images/avatar.jpg"
          alt="Axell Rojas"
          class="size-full object-cover object-top"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent"></div>
      </div>

      <!-- Names & Titles Container - Matches Photo Height Exactly -->
      <div class="flex flex-col justify-between h-36 text-center sm:text-left">
        <div>
          <h3 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-foreground leading-none">
            Axell Rojas
          </h3>
          <p class="font-mono text-xs sm:text-sm text-primary font-medium mt-1.5">
            IT Infrastructure &amp; AI Specialist
          </p>
        </div>
        <p class="text-xs text-muted-foreground leading-relaxed line-clamp-3">
          {modalBio}
        </p>
      </div>
    </div>

    <!-- Contact & Coordinates Grid: 4 Equal-Height Symmetrical Cards -->
    <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3 pt-6 border-t border-border">
      <!-- Card 1: Email -->
      <div class="h-[72px] flex items-center justify-between p-3.5 rounded-xl border border-border bg-secondary/40 hover:border-primary/40 transition-colors">
        <div class="overflow-hidden">
          <p class="font-mono text-[10px] text-muted-foreground uppercase">{data.playerCard.email}</p>
          <p class="font-mono text-xs text-foreground font-semibold truncate mt-0.5">axelry2402@gmail.com</p>
        </div>
        <button
          class="copy-btn shrink-0 ml-2 p-1.5 rounded-lg border border-border/80 bg-card hover:text-primary hover:border-primary/50 transition-colors cursor-pointer"
          data-copy="axelry2402@gmail.com"
          title="Copiar correo"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
        </button>
      </div>

      <!-- Card 2: Phone -->
      <div class="h-[72px] flex items-center justify-between p-3.5 rounded-xl border border-border bg-secondary/40 hover:border-primary/40 transition-colors">
        <div class="overflow-hidden">
          <p class="font-mono text-[10px] text-muted-foreground uppercase">{data.playerCard.phone}</p>
          <p class="font-mono text-xs text-foreground font-semibold truncate mt-0.5">+506 6359-9128</p>
        </div>
        <button
          class="copy-btn shrink-0 ml-2 p-1.5 rounded-lg border border-border/80 bg-card hover:text-primary hover:border-primary/50 transition-colors cursor-pointer"
          data-copy="+50663599128"
          title="Copiar teléfono"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
        </button>
      </div>

      <!-- Card 3: Location -->
      <div class="h-[72px] flex items-center justify-between p-3.5 rounded-xl border border-border bg-secondary/40 hover:border-primary/40 transition-colors">
        <div class="overflow-hidden">
          <p class="font-mono text-[10px] text-muted-foreground uppercase">{data.playerCard.location}</p>
          <p class="font-mono text-xs text-foreground font-semibold truncate mt-0.5">Naranjo, Alajuela, CR</p>
        </div>
        <span class="text-base">🇨🇷</span>
      </div>

      <!-- Card 4: Professional Profiles (Identical Height & Padding) -->
      <div class="h-[72px] flex items-center justify-between p-3.5 rounded-xl border border-border bg-secondary/40 hover:border-primary/40 transition-colors">
        <div class="overflow-hidden">
          <p class="font-mono text-[10px] text-muted-foreground uppercase">PERFILES PROFESIONALES</p>
          <div class="flex items-center gap-2 mt-1">
            <a
              href="https://github.com/STXNES"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-foreground hover:text-primary transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                <path d="M9 18c-4.51 2-5-2-7-2"></path>
              </svg>
              GitHub ↗
            </a>
            <span class="text-muted-foreground/40">·</span>
            <a
              href="https://linkedin.com/in/axro"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 font-mono text-xs font-semibold text-foreground hover:text-primary transition-colors"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
                <rect width="4" height="12" x="2" y="9"></rect>
                <circle cx="4" cy="4" r="2"></circle>
              </svg>
              LinkedIn ↗
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Download CV Action Button -->
    <div class="mt-5">
      <a
        href="/Axell_Rojas_CV.pdf"
        download="Axell_Rojas_CV.pdf"
        class="group flex w-full items-center justify-center gap-2.5 rounded-xl bg-primary px-5 py-3.5 font-mono text-xs font-bold uppercase tracking-wider text-primary-foreground shadow-lg shadow-primary/30 hover:bg-primary/90 transition-all hover:scale-[1.01]"
      >
        <svg class="size-4 transition-transform group-hover:-translate-y-0.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="7 10 12 15 17 10"></polyline>
          <line x1="12" x2="12" y1="15" y2="3"></line>
        </svg>
        {data.playerCard.downloadCv}
      </a>
    </div>
  </div>
</div>

<script>
  const playerTrigger = document.getElementById('player-card-trigger');
  const playerOverlay = document.getElementById('player-modal-overlay');
  const playerCard = document.getElementById('player-modal-card');
  const closePlayer = document.getElementById('close-player-modal');

  function openPlayerModal() {
    playerOverlay?.classList.remove('opacity-0', 'pointer-events-none');
    playerCard?.classList.remove('scale-95');
    playerCard?.classList.add('scale-100');
  }

  function closePlayerModal() {
    playerOverlay?.classList.add('opacity-0', 'pointer-events-none');
    playerCard?.classList.remove('scale-100');
    playerCard?.classList.add('scale-95');
  }

  playerTrigger?.addEventListener('click', openPlayerModal);
  closePlayer?.addEventListener('click', closePlayerModal);
  playerOverlay?.addEventListener('click', (e) => {
    if (e.target === playerOverlay) closePlayerModal();
  });

  window.addEventListener('open-dossier', openPlayerModal);

  document.querySelectorAll('.copy-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const text = btn.getAttribute('data-copy');
      if (text) {
        navigator.clipboard.writeText(text);
        const originalHtml = btn.innerHTML;
        btn.innerHTML = `<span class="text-emerald-500 font-mono text-[10px]">✓</span>`;
        setTimeout(() => {
          btn.innerHTML = originalHtml;
        }, 2000);
      }
    });
  });
</script>
