---
import { portfolioData } from '../data/portfolioData';

interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;
const data = portfolioData[currentLang];
---

<section id="certifications" class="relative scroll-mt-20 border-b border-border py-16 sm:py-24">
  <div class="pointer-events-none absolute inset-0 bg-grid opacity-20"></div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-16">
    <!-- Section Kicker Header -->
    <div class="flex items-center gap-3">
      <span class="h-px w-8 bg-primary"></span>
      <span class="font-mono text-xs font-semibold tracking-[0.3em] text-primary uppercase">
        {data.certifications.label}
      </span>
    </div>

    <div class="mt-4">
      <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
        Academic Degrees &amp; Professional Certifications
      </h2>
      <p class="mt-2 text-sm text-muted-foreground max-w-xl">
        Continuous formal education in Systems Engineering coupled with industry certifications across identity, networks, and AI engineering.
      </p>
    </div>

    <!-- 2 Column Layout: Education vs Certifications -->
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-12 gap-10">
      
      <!-- Academic Education (Col 1 - 5 cols) -->
      <div class="lg:col-span-5 space-y-6">
        <h3 class="font-mono text-xs font-bold tracking-widest text-primary uppercase flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-primary"></span>
          {data.certifications.educationTitle}
        </h3>

        <div class="space-y-4">
          {data.certifications.education.map((edu) => (
            <div class="brackets rounded-xl border border-border bg-card/60 p-5 backdrop-blur-sm">
              <span class="font-mono text-[10px] text-primary font-semibold uppercase tracking-wider">
                {edu.period}
              </span>
              <h4 class="mt-2 text-lg font-bold text-foreground">
                {edu.degree}
              </h4>
              <p class="text-xs text-muted-foreground mt-1">
                {edu.institution}
              </p>
              <div class="mt-3 flex items-center gap-2">
                <span class="size-2 rounded-full bg-emerald-500"></span>
                <span class="font-mono text-[11px] text-foreground font-medium">{edu.status}</span>
              </div>
            </div>
          ))}
        </div>

        <!-- Featured Badge Card (ONE AI / Tech AI Builder) -->
        <div class="brackets rounded-xl border border-primary/40 bg-card/80 p-5 backdrop-blur-md">
          <div class="flex items-center gap-4">
            <div class="size-16 shrink-0 rounded-lg overflow-hidden border border-primary/30 bg-muted/60 p-1 flex items-center justify-center">
              <img
                src="/images/badge-rag-agente-ia.png"
                alt="Badge RAG Agente Inteligente"
                class="size-full object-contain"
              />
            </div>
            <div>
              <span class="font-mono text-[10px] text-primary font-bold uppercase tracking-wider">SPECIALIZED CREDENTIAL</span>
              <h5 class="font-bold text-sm text-foreground mt-0.5">Alura Latam x Oracle (ONE)</h5>
              <p class="font-mono text-xs text-muted-foreground mt-0.5">Tech AI Builder &amp; RAG Agent Immersion</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Professional Certifications Grid (Col 2 - 7 cols) -->
      <div class="lg:col-span-7 space-y-6">
        <h3 class="font-mono text-xs font-bold tracking-widest text-primary uppercase flex items-center gap-2">
          <span class="size-1.5 rounded-full bg-primary"></span>
          {data.certifications.certsTitle}
        </h3>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {data.certifications.items.map((cert) => (
            <div class="group rounded-xl border border-border bg-card/50 p-4 transition-all hover:border-primary/50 hover:bg-card">
              <div class="flex items-center justify-between">
                <span class="font-mono text-[10px] text-primary font-semibold uppercase tracking-wider">
                  {cert.issuer}
                </span>
                <span class="font-mono text-[10px] text-muted-foreground">
                  {cert.year}
                </span>
              </div>
              <h4 class="mt-2 text-sm font-semibold text-foreground group-hover:text-primary transition-colors leading-snug">
                {cert.title}
              </h4>
              <div class="mt-3 flex items-center gap-1.5">
                <span class="size-1.5 rounded-full bg-emerald-500"></span>
                <span class="font-mono text-[10px] text-muted-foreground">{cert.status}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

    </div>
  </div>
</section>
