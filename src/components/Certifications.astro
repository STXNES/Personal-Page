---
import { portfolioData } from '../data/portfolioData';

interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;
const data = portfolioData[currentLang];
const isEn = currentLang === 'en';

const kLabel = isEn ? "Official Credentials" : "Credenciales Oficiales";
const kTitle = isEn ? "Academic Degrees & Industry Certifications" : "Educación Universitaria & Certificaciones de la Industria";
const kSub = isEn
  ? "Formal education in Systems Engineering coupled with verified industry certifications across identity, networks, and AI engineering."
  : "Educación universitaria en Ingeniería en Sistemas combinada con certificaciones de industria en identidad, redes y computación en la nube.";
---

<section id="certifications" class="relative scroll-mt-24 py-12 border-b border-slate-800/80 space-y-8">
  <!-- Section Kicker Header -->
  <div class="border-b border-slate-800/80 pb-6">
    <span class="text-cyan-400 font-mono text-xs uppercase tracking-wider">{kLabel}</span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-1 tracking-tight">{kTitle}</h2>
    <p class="text-slate-400 text-sm mt-1.5 max-w-xl leading-relaxed">
      {kSub}
    </p>
  </div>

  <!-- 2 Column Layout: Education vs Certifications -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Academic Education (Col 1 - 5 cols) -->
    <div class="lg:col-span-5 space-y-4">
      <h3 class="font-mono text-xs font-bold tracking-widest text-cyan-400 uppercase flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-cyan-400"></span>
        {data.certifications.educationTitle}
      </h3>

      <div class="space-y-3.5">
        {data.certifications.education.map((edu) => (
          <div class="glass-card rounded-2xl p-5 space-y-2">
            <div class="flex items-center justify-between">
              <span class="font-mono text-[10px] text-cyan-400 font-semibold uppercase tracking-wider">
                {edu.period}
              </span>
              <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <span class="size-1 rounded-full bg-emerald-400"></span>
                {edu.status}
              </span>
            </div>
            <h4 class="text-base font-bold text-white">
              {edu.degree}
            </h4>
            <p class="text-xs text-slate-400 font-mono">
              {edu.institution}
            </p>
          </div>
        ))}
      </div>

      <!-- Featured Badge Card (ONE AI / Tech AI Builder) -->
      <div class="glass-card rounded-2xl p-5 border-cyan-500/30 bg-gradient-to-br from-slate-900/90 via-slate-900/60 to-cyan-950/20">
        <div class="flex items-center gap-4">
          <div class="size-16 shrink-0 rounded-xl overflow-hidden border border-cyan-500/30 bg-slate-950/80 p-2 flex items-center justify-center">
            <img
              src="/images/badge-rag-agente-ia.png"
              alt="Badge RAG Agente Inteligente"
              class="size-full object-contain"
            />
          </div>
          <div>
            <span class="font-mono text-[10px] text-cyan-400 font-bold uppercase tracking-wider">SPECIALIZED CREDENTIAL</span>
            <h5 class="font-bold text-sm text-white mt-0.5">Alura Latam × Oracle (ONE)</h5>
            <p class="font-mono text-xs text-slate-400 mt-0.5">Tech AI Builder &amp; RAG Agent Immersion</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Professional Certifications Grid (Col 2 - 7 cols) -->
    <div class="lg:col-span-7 space-y-4">
      <h3 class="font-mono text-xs font-bold tracking-widest text-cyan-400 uppercase flex items-center gap-2">
        <span class="size-1.5 rounded-full bg-cyan-400"></span>
        {data.certifications.certsTitle}
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
        {data.certifications.items.map((cert) => {
          const isPending = cert.status.toLowerCase().includes('programad') || cert.status.toLowerCase().includes('schedul');
          const statusBadgeClass = isPending
            ? 'bg-amber-500/10 text-amber-300 border-amber-500/20'
            : 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';

          return (
            <div class="glass-card rounded-2xl p-4 flex flex-col justify-between space-y-3 hover:border-cyan-500/40 transition-colors">
              <div>
                <div class="flex items-center justify-between">
                  <span class="font-mono text-[10px] text-cyan-400 font-semibold uppercase tracking-wider">
                    {cert.issuer}
                  </span>
                  <span class="font-mono text-[10px] text-slate-500">
                    {cert.year}
                  </span>
                </div>
                <h4 class="mt-2 text-sm font-semibold text-white leading-snug">
                  {cert.title}
                </h4>
              </div>

              <div class="flex items-center justify-between pt-2 border-t border-slate-800/60">
                <span class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded text-[10px] font-mono border ${statusBadgeClass}`}>
                  <span class={`size-1 rounded-full ${isPending ? 'bg-amber-400' : 'bg-emerald-400'}`}></span>
                  {cert.status}
                </span>
              </div>
            </div>
          );
        })}
      </div>
    </div>

  </div>
</section>
