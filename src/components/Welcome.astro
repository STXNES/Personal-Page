<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Coming Soon</title>
    <link href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html, body {
        height: 100%;
      }

      body {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'Space Mono', monospace;
        background-color: #0d0c1d;
        background-image:
          radial-gradient(ellipse 90% 50% at 50% -5%, rgba(100, 60, 220, 0.18), transparent),
          radial-gradient(ellipse 60% 40% at 90% 90%, rgba(60, 30, 160, 0.12), transparent);
        padding: 2rem;
      }

      body::before {
        content: '';
        position: fixed;
        inset: 0;
        background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
        background-size: 26px 26px;
        pointer-events: none;
        z-index: 0;
      }

      .card {
        position: relative;
        z-index: 1;
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 28px;
        padding: 2rem;
        max-width: 400px;
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1.6rem;
        align-items: flex-start;
        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
        box-shadow:
          0 0 0 1px rgba(255, 255, 255, 0.04) inset,
          0 40px 80px rgba(0, 0, 0, 0.4);
      }

      .label {
        font-size: 10px;
        letter-spacing: 0.3em;
        color: #FFB800;
      }

      h1 {
        font-size: clamp(15px, 2.8vw, 21px);
        font-weight: 400;
        line-height: 1.6;
        color: #eae8ff;
        min-height: 2.4em;
      }

      .cursor {
        display: inline-block;
        color: #FFB800;
        margin-left: 1px;
        animation: blink 1s step-end infinite;
      }

      @keyframes blink {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0; }
      }

      .gif-block {
        width: 100%;
        border-radius: 18px;
        overflow: hidden;
        position: relative;
        border: 1px solid rgba(255, 255, 255, 0.07);
      }

      .gif-block img {
        width: 100%;
        height: auto;
        display: block;
        filter: brightness(0.9) saturate(1.1);
      }

      .gif-block::after {
        content: '';
        position: absolute;
        bottom: 0;
        left: 0;
        right: 0;
        height: 48px;
        background: linear-gradient(to top, rgba(13, 12, 29, 0.75), transparent);
        pointer-events: none;
      }

      .gif-tag {
        position: absolute;
        bottom: 10px;
        left: 14px;
        z-index: 2;
        font-size: 8px;
        letter-spacing: 0.18em;
        color: rgba(255, 255, 255, 0.35);
      }

      .gif-glow {
        width: 70%;
        height: 1px;
        margin: -8px auto 0;
        background: rgba(120, 80, 255, 0.35);
        filter: blur(10px);
        border-radius: 50%;
      }

      /* Bottom row: button + powered by */
      .bottom-row {
        display: flex;
        align-items: center;
        gap: 4rem;
        width: 100%;
        flex-wrap: wrap;
      }

      .btn {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 12px 28px;
        font-family: 'Space Mono', monospace;
        font-size: 11px;
        letter-spacing: 0.06em;
        color: #0d0c1d;
        background: #FFB840;
        text-decoration: none;
        border-radius: 999px;
        overflow: hidden;
        transition: opacity 0.2s ease, transform 0.15s ease;
        white-space: nowrap;
      }

      .btn::before {
        content: '';
        position: absolute;
        top: 0;
        left: -80%;
        width: 55%;
        height: 100%;
        background: linear-gradient(
          100deg,
          transparent 20%,
          rgba(255, 255, 255, 0.5) 50%,
          transparent 80%
        );
        animation: shimmer 2.8s ease-in-out infinite;
      }

      @keyframes shimmer {
        0%   { left: -80%; }
        100% { left: 160%; }
      }

      .btn:hover {
        opacity: 0.88;
        transform: translateY(-1px);
      }

      .btn:active {
        transform: translateY(0);
      }

      /* Powered by */
      .powered {
        display: flex;
        flex-direction: column;
        gap: 6px;
		margin-bottom: 5px;
      }

      .powered-label {
        font-size: 10px;
        letter-spacing: 0.2em;
        color: rgba(255, 255, 255, 0.25);
        text-transform: lowercase;
      }

      .tech-icons {
        display: flex;
        align-items: center;
        gap: 7px;
      }

      .tech-icons img {
        width: 18px;
        height: 18px;
        opacity: 0.7;
        transition: opacity 0.2s ease, transform 0.2s ease;
        filter: grayscale(20%);
      }

      .tech-icons img:hover {
        opacity: 1;
        transform: translateY(-2px);
      }

      @media (max-width: 480px) {
        .card {
          padding: 1.5rem;
          border-radius: 22px;
        }

        .gif-block {
          border-radius: 14px;
        }
      }
    </style>
  </head>
  <body>
    <div class="card">
      <p class="label">axro.dev</p>

      <h1><span class="typewriter"></span><span class="cursor">_</span></h1>

      <div>
        <div class="gif-block">
          <img
            src="https://media.giphy.com/media/l3q2K5jinAlChoCLS/giphy.gif"
            alt="Michael Scott from The Office"
          />
          <span class="gif-tag">The Office (US) — NBC</span>
        </div>
        <div class="gif-glow"></div>
      </div>

      <div class="bottom-row">
        <a href="https://www.linkedin.com/in/axro/" class="btn">← back to profile</a>

        <div class="powered">
          <span class="powered-label">powered by</span>
          <div class="tech-icons">
            <img src="https://skillicons.dev/icons?i=astro" alt="Astro" title="Astro" />
            <img src="https://skillicons.dev/icons?i=react" alt="React" title="React" />
            <img src="https://skillicons.dev/icons?i=tailwind" alt="Tailwind CSS" title="Tailwind CSS" />
          </div>
        </div>
      </div>
    </div>

    <script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const el = document.querySelector('.typewriter');
    if (!el) return;

    const fullText = "this page is being developed";
    let i = 0;

    function type() {
      if (i < fullText.length) {
        el.textContent += fullText[i];
        i++;
        setTimeout(type, 55);
      }
    }

    setTimeout(type, 500);
  });
</script>
</script>
  </body>
</html>