---
import { portfolioData } from '../data/portfolioData';

interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;
const data = portfolioData[currentLang];
---

<section id="work" class="relative scroll-mt-20 border-b border-border py-16 sm:py-24">
  <div class="pointer-events-none absolute inset-0 bg-grid opacity-20"></div>

  <div class="relative mx-auto max-w-7xl px-6 lg:px-16">
    <!-- Section Kicker Header -->
    <div class="flex items-center gap-3">
      <span class="h-px w-8 bg-primary"></span>
      <span class="font-mono text-xs font-semibold tracking-[0.3em] text-primary uppercase">
        {data.work.label}
      </span>
    </div>

    <!-- Section Intro Headline -->
    <div class="mt-4 flex flex-col md:flex-row md:items-end justify-between gap-4">
      <div>
        <h2 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-foreground">
          Production Systems &amp; Engineering Labs
        </h2>
        <p class="mt-2 text-sm text-muted-foreground max-w-xl">
          Architectural implementations spanning enterprise infrastructure, Active Directory domain administration, and intelligent agentic RAG workflows.
        </p>
      </div>

      <a
        href="https://github.com/STXNES"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-primary hover:underline self-start md:self-end"
      >
        <span>View all on GitHub (@STXNES)</span>
        <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </a>
    </div>

    <!-- Projects Grid: All Cards Equal Height with justify-between -->
    <div class="mt-12 grid grid-cols-1 lg:grid-cols-2 gap-8 items-stretch">
      {data.work.projects.map((project, index) => (
        <article
          id={project.id}
          class="brackets group flex flex-col justify-between h-full rounded-2xl border border-border bg-card/75 p-6 sm:p-8 backdrop-blur-md transition-all hover:border-primary/60 hover:shadow-xl hover:shadow-primary/10"
        >
          <div>
            <!-- Top Tag & Number Indicator -->
            <div class="flex items-center justify-between">
              <span class="font-mono text-xs font-bold tracking-widest text-primary uppercase border border-primary/30 px-3 py-1 rounded-full bg-primary/10">
                {project.tag}
              </span>
              <span class="font-mono text-2xl font-black text-muted-foreground/60 group-hover:text-primary transition-colors">
                0{index + 1}
              </span>
            </div>

            <!-- Project Preview Mockup Image -->
            <div class="mt-5 aspect-video w-full overflow-hidden rounded-xl border border-border bg-muted/40 relative group-hover:border-primary/40 transition-colors">
              <img
                src={project.image}
                alt={project.name}
                class="size-full object-cover object-top transition-transform duration-500 group-hover:scale-[1.02]"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-card/80 via-transparent to-transparent pointer-events-none"></div>
            </div>

            <!-- Title & Short Description -->
            <h3 class="mt-6 text-xl sm:text-2xl font-bold text-foreground group-hover:text-primary transition-colors">
              {project.name}
            </h3>
            <p class="mt-2 text-xs sm:text-sm text-muted-foreground leading-relaxed">
              {project.summary}
            </p>

            <!-- Core Technical Highlights Bullets (Max 2 concise bullets for recruiters) -->
            <ul class="mt-4 space-y-2 text-xs text-foreground/85">
              {project.bullets.slice(0, 2).map((b) => (
                <li class="flex items-start gap-2">
                  <span class="text-primary font-mono text-xs mt-0.5 font-bold">✓</span>
                  <span class="leading-relaxed">{b}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Bottom Container: Stack and Actions -->
          <div class="mt-6">
            <!-- Tech Stack Tags -->
            <div class="flex flex-wrap gap-1.5 pt-5 border-t border-border">
              {project.stack.slice(0, 6).map((tech) => (
                <span class="font-mono text-[11px] rounded-md border border-border bg-secondary/50 px-2 py-0.5 text-foreground/80">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Action Buttons Footer -->
            <div class="mt-6 flex items-center justify-between pt-4 border-t border-border/80">
              <button
                type="button"
                data-project-id={project.id}
                class="view-details-btn inline-flex items-center gap-1.5 font-mono text-xs font-semibold text-primary uppercase tracking-wider hover:underline cursor-pointer"
              >
                <span>{data.work.viewDetails}</span>
                <svg class="size-3.5 transition-transform group-hover:translate-x-1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </button>

              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-mono text-muted-foreground hover:text-foreground transition-colors"
              >
                <svg class="size-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
                  <path d="M9 18c-4.51 2-5-2-7-2"></path>
                </svg>
                <span>Repo ↗</span>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.view-details-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.getAttribute('data-project-id');
      if (id) {
        window.dispatchEvent(new CustomEvent('open-project-modal', { detail: { id } }));
      }
    });
  });
</script>
