---
import { portfolioData } from '../data/portfolioData';

interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;
const data = portfolioData[currentLang];
const isEn = currentLang === 'en';

const kLabel = isEn ? "Practical Labs & Production Systems" : "Laboratorios Prácticos & Producción";
const kTitle = isEn ? "Systems Architecture & Automation" : "Arquitectura de Sistemas & Automatización";
const kSub = isEn
  ? "Real systems deployed with technical documentation, enterprise topologies, and open source code on GitHub."
  : "Proyectos reales desplegados con documentación técnica, topologías y código fuente abierto en GitHub.";

const filterLabels = {
  all: isEn ? "All (5)" : "Todos (5)",
  infra: isEn ? "Infrastructure & Linux" : "Infraestructura & Linux",
  devops: isEn ? "DevOps & CI/CD" : "DevOps & CI/CD",
  ai: isEn ? "Agentic AI & RAG" : "IA Agéntica & RAG",
};

const viewDetailsText = isEn ? "Architecture Details" : "Detalles de Arquitectura";
const viewRepoText = isEn ? "View Repository ↗" : "Ver Repositorio ↗";
---

<section id="projects" class="relative scroll-mt-24 py-12 sm:py-16 space-y-8 border-b border-slate-800/80">
  <!-- Section Header & Filter Controls -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b border-slate-800/80 pb-6">
    <div>
      <span class="text-cyan-400 font-mono text-xs uppercase tracking-wider">{kLabel}</span>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-1 tracking-tight">{kTitle}</h2>
      <p class="text-slate-400 text-sm mt-1.5 max-w-xl leading-relaxed">
        {kSub}
      </p>
    </div>

    <!-- Segmented Filter Buttons -->
    <div class="flex flex-wrap gap-1.5 bg-slate-900/90 p-1.5 rounded-xl border border-slate-800 text-xs font-medium self-start md:self-end">
      <button
        type="button"
        id="btn-all"
        data-category="all"
        class="filter-btn px-3 py-1.5 rounded-lg bg-cyan-500 text-slate-950 font-bold transition cursor-pointer"
      >
        {filterLabels.all}
      </button>
      <button
        type="button"
        id="btn-infra"
        data-category="infra"
        class="filter-btn px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition cursor-pointer"
      >
        {filterLabels.infra}
      </button>
      <button
        type="button"
        id="btn-devops"
        data-category="devops"
        class="filter-btn px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition cursor-pointer"
      >
        {filterLabels.devops}
      </button>
      <button
        type="button"
        id="btn-ai"
        data-category="ai"
        class="filter-btn px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition cursor-pointer"
      >
        {filterLabels.ai}
      </button>
    </div>
  </div>

  <!-- Bento Grid Projects Container -->
  <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-stretch">
    {data.work.projects.map((project, index) => {
      const isLinuxHero = project.id === 'linux-hardening';
      const colClass = isLinuxHero ? 'lg:col-span-2' : 'lg:col-span-1';
      const cat = project.category || 'infra';

      return (
        <article
          id={`card-${project.id}`}
          data-category={cat}
          class={`project-card ${cat} ${colClass} glass-card rounded-2xl p-6 sm:p-7 flex flex-col justify-between space-y-6 transition-all duration-300 hover:border-cyan-500/50 hover:shadow-xl hover:shadow-cyan-500/5 group`}
        >
          <div class="space-y-4">
            <!-- Top Badge Strip -->
            <div class="flex items-center justify-between">
              <span class="badge-pill px-3 py-1 rounded-md text-[11px] font-mono font-semibold">
                {project.tag}
              </span>
              <span class="text-xs text-slate-400 font-mono">
                {project.meta.highlight || `0${index + 1}`}
              </span>
            </div>

            <!-- Project Name -->
            <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-cyan-400 transition-colors">
              {project.name}
            </h3>

            <!-- Summary Description -->
            <p class="text-slate-300 text-sm leading-relaxed">
              {project.summary}
            </p>

            {/* Special Specs Display for Linux Hero Card */}
            {isLinuxHero && (
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-2 text-xs font-mono">
                <div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800">
                  <span class="text-cyan-400 block text-[10px] uppercase font-semibold">SSH Endurecido</span>
                  Port 2222 · ed25519
                </div>
                <div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800">
                  <span class="text-cyan-400 block text-[10px] uppercase font-semibold">Firewall UFW</span>
                  Default DROP · 3 Jails
                </div>
                <div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800">
                  <span class="text-cyan-400 block text-[10px] uppercase font-semibold">Web Server</span>
                  Nginx · TLS 1.3
                </div>
                <div class="bg-slate-950/60 p-2.5 rounded-lg border border-slate-800">
                  <span class="text-cyan-400 block text-[10px] uppercase font-semibold">Respaldos</span>
                  zstd + GPG (SHA-256)
                </div>
              </div>
            )}

            {/* Key Bullets for Other Cards */}
            {!isLinuxHero && project.bullets && (
              <ul class="space-y-1.5 pt-1 text-xs text-slate-300">
                {project.bullets.slice(0, 2).map((bullet) => (
                  <li class="flex items-start gap-2">
                    <span class="text-cyan-400 font-mono mt-0.5 font-bold">✓</span>
                    <span class="leading-relaxed">{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <!-- Bottom Container: Stack + Actions -->
          <div class="space-y-4 pt-4 border-t border-slate-800/80">
            <!-- Tech Stack Tags -->
            <div class="flex flex-wrap gap-1.5">
              {project.stack.slice(0, 4).map((tech) => (
                <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-slate-800/80 text-slate-300 border border-slate-700/50">
                  {tech}
                </span>
              ))}
            </div>

            <!-- Action Buttons Footer -->
            <div class="flex items-center justify-between pt-2">
              <button
                type="button"
                data-project-id={project.id}
                class="view-modal-trigger text-xs font-mono font-semibold text-cyan-400 hover:text-cyan-300 transition-colors flex items-center gap-1.5 cursor-pointer"
              >
                <span>{viewDetailsText}</span>
                <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </button>

              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold text-slate-300 hover:text-white flex items-center gap-1 font-mono transition-colors"
              >
                <span>{viewRepoText}</span>
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>
</section>

<script>
  // Filter Functionality
  const filterButtons = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const projectCards = document.querySelectorAll<HTMLElement>('.project-card');

  filterButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const selected = btn.getAttribute('data-category') || 'all';

      // Update button styles
      filterButtons.forEach((b) => {
        if (b === btn) {
          b.className = 'filter-btn px-3 py-1.5 rounded-lg bg-cyan-500 text-slate-950 font-bold transition cursor-pointer';
        } else {
          b.className = 'filter-btn px-3 py-1.5 rounded-lg text-slate-400 hover:text-white transition cursor-pointer';
        }
      });

      // Filter cards
      projectCards.forEach((card) => {
        const cat = card.getAttribute('data-category');
        if (selected === 'all' || cat === selected) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    });
  });

  // Modal Trigger Handlers
  document.querySelectorAll('.view-modal-trigger').forEach((trigger) => {
    trigger.addEventListener('click', () => {
      const id = trigger.getAttribute('data-project-id');
      if (id) {
        window.dispatchEvent(new CustomEvent('open-project-modal', { detail: { id } }));
      }
    });
  });
</script>
