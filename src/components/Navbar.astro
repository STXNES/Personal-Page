---
interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;

const labels = {
  es: {
    home: "Inicio",
    work: "Proyectos",
    experience: "Experiencia",
    terminal: "Terminal",
    stack: "Stack",
    certifications: "Certificaciones",
    about: "Sobre Mí",
    cv: "CV (PDF)",
    switchLang: "English (EN)",
    targetLang: "en"
  },
  en: {
    home: "Home",
    work: "Projects",
    experience: "Experience",
    terminal: "Terminal",
    stack: "Stack",
    certifications: "Certifications",
    about: "About",
    cv: "CV (PDF)",
    switchLang: "Español (ES)",
    targetLang: "es"
  }
}[currentLang];
---

<header class="sticky top-0 z-50 w-full pt-3 sm:pt-4 pointer-events-none transition-all duration-300">
  <!-- Outer container with EXACT same max-width and responsive padding as main content -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="w-full glass-nav rounded-2xl px-4 sm:px-6 h-16 flex items-center justify-between pointer-events-auto border border-slate-800/80 shadow-2xl shadow-black/50 backdrop-blur-xl">
      <!-- Brand / Identifier -->
      <a href="#hero" class="flex items-center gap-3 group shrink-0">
        <div class="size-9 rounded-xl bg-gradient-to-br from-cyan-400 to-blue-600 flex items-center justify-center font-bold text-slate-950 text-sm shadow-md shadow-cyan-500/20 group-hover:scale-105 transition-transform font-mono">
          AR
        </div>
        <div class="flex items-center">
          <span class="font-bold tracking-tight text-white text-sm sm:text-base group-hover:text-cyan-400 transition-colors">Axell Rojas</span>
          <span class="hidden xl:inline-block text-xs text-slate-400 ml-2 border-l border-slate-800 pl-2 font-mono">sysadmin@infrastructure</span>
        </div>
      </a>

      <!-- Desktop Navigation Links (Spacious Floating Pill) -->
      <nav class="hidden lg:flex items-center gap-1 bg-slate-900/90 p-1.5 rounded-xl border border-slate-800/80 text-xs font-medium backdrop-blur-md">
        <a href="#hero" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors">{labels.home}</a>
        <a href="#projects" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors">{labels.work}</a>
        <a href="#experience" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors">{labels.experience}</a>
        <a href="#terminal" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors">{labels.terminal}</a>
        <a href="#stack" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors">{labels.stack}</a>
        <a href="#certifications" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors">{labels.certifications}</a>
        <a href="#about" class="px-3 py-1.5 rounded-lg text-slate-300 hover:text-white hover:bg-slate-800/80 transition-colors">{labels.about}</a>
      </nav>

      <!-- Right-Side Action Controls -->
      <div class="flex items-center gap-2.5 shrink-0">
        <!-- Language Switcher Pill -->
        <a
          href={currentLang === 'es' ? '/en' : '/es'}
          class="flex items-center gap-1.5 rounded-xl border border-slate-800 bg-slate-900/90 px-3 py-2 text-xs font-mono font-medium text-slate-300 hover:text-cyan-400 hover:border-cyan-500/40 transition-colors"
          title={labels.switchLang}
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
          <span class="uppercase tracking-wider font-bold">{currentLang === 'es' ? 'EN' : 'ES'}</span>
        </a>

        <!-- Direct PDF CV Download Button -->
        <a
          href="/Axell_Rojas_CV.pdf"
          download="Axell_Rojas_CV.pdf"
          class="hidden sm:inline-flex items-center gap-1.5 text-xs font-semibold bg-gradient-to-r from-cyan-500 to-blue-600 hover:brightness-110 text-slate-950 px-3.5 py-2 rounded-xl transition-all shadow-md shadow-cyan-500/20 cursor-pointer"
        >
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>{labels.cv}</span>
        </a>

        <!-- Mobile Menu Hamburger Button -->
        <button
          id="navbar-mobile-toggle"
          type="button"
          aria-label="Abrir menú"
          class="lg:hidden flex size-9 items-center justify-center rounded-xl border border-slate-800 bg-slate-900/90 text-white"
        >
          <svg class="size-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"/></svg>
        </button>
      </div>
    </div>

    <!-- Mobile Dropdown Menu (Strictly within the same aligned container) -->
    <div id="navbar-mobile-menu" class="hidden lg:hidden w-full mt-2 rounded-2xl border border-slate-800 bg-slate-950/95 backdrop-blur-xl px-6 py-4 space-y-2 pointer-events-auto shadow-2xl">
      <a href="#hero" class="block py-2 text-sm text-slate-300 hover:text-cyan-400 transition-colors">{labels.home}</a>
      <a href="#projects" class="block py-2 text-sm text-slate-300 hover:text-cyan-400 transition-colors">{labels.work}</a>
      <a href="#experience" class="block py-2 text-sm text-slate-300 hover:text-cyan-400 transition-colors">{labels.experience}</a>
      <a href="#terminal" class="block py-2 text-sm text-slate-300 hover:text-cyan-400 transition-colors">{labels.terminal}</a>
      <a href="#stack" class="block py-2 text-sm text-slate-300 hover:text-cyan-400 transition-colors">{labels.stack}</a>
      <a href="#certifications" class="block py-2 text-sm text-slate-300 hover:text-cyan-400 transition-colors">{labels.certifications}</a>
      <a href="#about" class="block py-2 text-sm text-slate-300 hover:text-cyan-400 transition-colors">{labels.about}</a>
      <div class="pt-3 border-t border-slate-800">
        <a
          href="/Axell_Rojas_CV.pdf"
          download="Axell_Rojas_CV.pdf"
          class="w-full flex items-center justify-center gap-2 text-xs font-semibold bg-gradient-to-r from-cyan-500 to-blue-600 text-slate-950 py-2.5 rounded-xl font-bold"
        >
          <svg class="size-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          <span>{labels.cv}</span>
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('navbar-mobile-toggle');
  const mobileMenu = document.getElementById('navbar-mobile-menu');

  toggleBtn?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });

  // Close mobile menu on clicking any link
  mobileMenu?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', () => {
      mobileMenu.classList.add('hidden');
    });
  });
</script>
