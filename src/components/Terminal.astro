---
interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;

const isEn = currentLang === 'en';

const title = isEn ? "Systems Command Terminal" : "Simulador de Terminal de Sistemas";
const subtitle = isEn ? "Type 'help' to see available diagnostic commands" : "Escribe 'help' para comandos";
const kLabel = isEn ? "Interactive Shell" : "Consola Interactiva";

const welcomeMsg = isEn
  ? "Welcome to Axell Rojas Systems Terminal (v2.4.0-release)<br/>Type <span class=\"text-cyan-400 font-bold\">help</span>, <span class=\"text-cyan-400 font-bold\">skills</span>, <span class=\"text-cyan-400 font-bold\">certs</span>, <span class=\"text-cyan-400 font-bold\">contact</span> or <span class=\"text-cyan-400 font-bold\">clear</span>."
  : "Welcome to Axell Rojas Systems Terminal (v2.4.0-release)<br/>Escribe <span class=\"text-cyan-400 font-bold\">help</span>, <span class=\"text-cyan-400 font-bold\">skills</span>, <span class=\"text-cyan-400 font-bold\">certs</span>, <span class=\"text-cyan-400 font-bold\">contact</span> o <span class=\"text-cyan-400 font-bold\">clear</span>.";

const summaryJson = isEn ? `{
  "status": "Available for Systems Admin & Cloud Infrastructure Roles",
  "top_skills": ["Active Directory", "Windows Server 2022", "Linux CIS L2", "Entra ID", "Python", "DevOps"],
  "clearance": "Intel TSX Cleanroom Qualification (24/7 Operations)",
  "education": "B.S. Systems Engineering (In Progress) · Web Dev Tech (Degree Awarded)"
}` : `{
  "status": "Disponible para Soporte TI L2/L3, SysAdmin e Infraestructura Cloud",
  "top_skills": ["Active Directory", "Windows Server 2022", "Linux CIS L2", "Entra ID", "Python", "DevOps"],
  "clearance": "Calificación Sala Limpia Intel TSX (Operaciones Críticas 24/7)",
  "education": "Ingeniería en Sistemas (En Curso) · Técnico en Desarrollo Web (Graduado)"
}`;
---

<section id="terminal" class="relative scroll-mt-24 py-12">
  <div class="space-y-4">
    <div class="flex items-center justify-between">
      <div>
        <span class="text-cyan-400 font-mono text-xs uppercase tracking-wider">{kLabel}</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">{title}</h2>
      </div>
      <span class="text-xs font-mono text-slate-400 hidden sm:inline-block bg-slate-900/80 px-3 py-1 rounded-md border border-slate-800">
        {subtitle}
      </span>
    </div>

    <div class="bg-[#0D1117] border border-slate-800 rounded-xl overflow-hidden shadow-2xl font-mono text-xs sm:text-sm">
      <!-- Mac / Shell Title Bar -->
      <div class="bg-[#161B22] px-4 py-2.5 flex items-center justify-between border-b border-slate-800">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-[#FF5F56] inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-[#FFBD2E] inline-block"></span>
          <span class="w-3 h-3 rounded-full bg-[#27C93F] inline-block"></span>
          <span class="text-slate-400 text-xs ml-2">axell@sysadmin: ~</span>
        </div>
        <span class="text-slate-500 text-xs">zsh 5.9</span>
      </div>

      <!-- Terminal Body -->
      <div id="terminal-body" class="p-5 space-y-3 min-h-[220px] max-h-[360px] overflow-y-auto">
        <div class="text-slate-400" set:html={welcomeMsg} />
        <div class="text-slate-300">
          <span class="text-cyan-400 font-bold">axell@sysadmin:~$</span> cat quick-summary.json
        </div>
        <pre class="text-slate-300 bg-slate-950/70 p-3 rounded-lg border border-slate-800/80 leading-relaxed overflow-x-auto">{summaryJson}</pre>
      </div>

      <!-- Terminal Input Line -->
      <div class="bg-slate-950/90 px-5 py-3 border-t border-slate-800/80 flex items-center gap-2">
        <span class="text-cyan-400 font-bold">axell@sysadmin:~$</span>
        <input
          type="text"
          id="terminal-input"
          placeholder={isEn ? "Type a command (try: 'skills', 'certs', 'contact')..." : "Escribe un comando (ej: 'skills', 'certs', 'contact')..."}
          class="bg-transparent border-none outline-none text-white w-full text-xs sm:text-sm font-mono placeholder-slate-600"
          autocomplete="off"
          spellcheck="false"
        />
      </div>
    </div>
  </div>
</section>

<script>
  const termInput = document.getElementById('terminal-input') as HTMLInputElement | null;
  const termBody = document.getElementById('terminal-body');

  if (termInput && termBody) {
    const isEn = (document.documentElement.getAttribute('lang') || 'es') === 'en';

    termInput.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') {
        const cmd = termInput.value.trim().toLowerCase();
        termInput.value = '';

        const cmdLine = document.createElement('div');
        cmdLine.className = 'text-slate-300';
        cmdLine.innerHTML = `<span class="text-cyan-400 font-bold">axell@sysadmin:~$</span> ${cmd}`;
        termBody.appendChild(cmdLine);

        let response = '';

        switch (cmd) {
          case 'help':
            response = isEn
              ? `<div class="text-slate-400">Available commands:<br/>
                • <span class="text-cyan-400">skills</span>: Enterprise infrastructure & software stack.<br/>
                • <span class="text-cyan-400">certs</span>: Active & upcoming Microsoft / Cisco certs.<br/>
                • <span class="text-cyan-400">contact</span>: Direct email, phone, and LinkedIn info.<br/>
                • <span class="text-cyan-400">whoami</span>: Candidate profile summary.<br/>
                • <span class="text-cyan-400">ping dc01</span>: Ping test to Windows Server Domain Controller.<br/>
                • <span class="text-cyan-400">clear</span>: Clear terminal console screen.</div>`
              : `<div class="text-slate-400">Comandos disponibles:<br/>
                • <span class="text-cyan-400">skills</span>: Listado de stack de infraestructura y software.<br/>
                • <span class="text-cyan-400">certs</span>: Certificaciones activas y programadas.<br/>
                • <span class="text-cyan-400">contact</span>: Enlaces directos a correo y teléfono.<br/>
                • <span class="text-cyan-400">whoami</span>: Perfil resumido de Axell Rojas.<br/>
                • <span class="text-cyan-400">ping dc01</span>: Prueba de conectividad al Domain Controller.<br/>
                • <span class="text-cyan-400">clear</span>: Limpiar pantalla de terminal.</div>`;
            break;
          case 'skills':
            response = `<div class="text-emerald-400">
              Windows Server 2022 • Active Directory DS • GPOs • Linux (Debian/RHEL CIS L2) • Nginx TLS 1.3 • UFW • Docker • Python • Bash • PowerShell • PostgreSQL (Neon) • n8n • LangChain • FAISS</div>`;
            break;
          case 'certs':
            response = `<div class="text-amber-300 space-y-1">
              <div>- SC-300: Microsoft Identity & Access Administrator (Scheduled 2026)</div>
              <div>- MD-102: Microsoft Endpoint Administrator (Scheduled 2026)</div>
              <div>- Cisco CCNA: Introduction to Networks (Completed)</div>
              <div>- ONE Tech AI Builder: Oracle × Alura Latam (Completed)</div></div>`;
            break;
          case 'contact':
            response = `<div class="text-cyan-300 space-y-0.5">
              <div>Email: <a href="mailto:axelry2402@gmail.com" class="underline">axelry2402@gmail.com</a></div>
              <div>Phone / WhatsApp: +506 6359-9128</div>
              <div>LinkedIn: <a href="https://www.linkedin.com/in/axro" target="_blank" class="underline">linkedin.com/in/axro</a></div>
              <div>GitHub: <a href="https://github.com/STXNES" target="_blank" class="underline">github.com/STXNES</a></div>
              <div>Location: Alajuela, Costa Rica (Open to Remote & On-site)</div></div>`;
            break;
          case 'whoami':
            response = isEn
              ? `<div class="text-slate-200">Axell Rojas — IT Support L2/L3 & Cloud Infrastructure Specialist. 2+ years of critical 24/7 manufacturing operations at Intel Corporation.</div>`
              : `<div class="text-slate-200">Axell Rojas — Especialista en Soporte TI L2/L3 e Infraestructura Cloud. 2+ años de experiencia en operaciones críticas 24/7 en Intel Corporation.</div>`;
            break;
          case 'ping dc01':
            response = `<div class="text-cyan-400">
              PING dc01.lab.internal (192.168.10.10): 56 data bytes<br/>
              64 bytes from 192.168.10.10: icmp_seq=0 ttl=128 time=0.412 ms<br/>
              64 bytes from 192.168.10.10: icmp_seq=1 ttl=128 time=0.389 ms<br/>
              --- dc01.lab.internal ping statistics ---<br/>
              2 packets transmitted, 2 packets received, 0.0% packet loss</div>`;
            break;
          case 'clear':
            termBody.innerHTML = '';
            return;
          default:
            response = isEn
              ? `<div class="text-red-400">Command not recognized: '${cmd}'. Type <span class="text-cyan-400 font-bold">help</span> to view available commands.</div>`
              : `<div class="text-red-400">Comando no reconocido: '${cmd}'. Escribe <span class="text-cyan-400 font-bold">help</span> para ver comandos.</div>`;
        }

        const resDiv = document.createElement('div');
        resDiv.innerHTML = response;
        termBody.appendChild(resDiv);

        termBody.scrollTop = termBody.scrollHeight;
      }
    });
  }
</script>
