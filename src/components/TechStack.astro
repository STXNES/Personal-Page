---
import { portfolioData } from '../data/portfolioData';

interface Props {
  currentLang?: 'en' | 'es';
}

const { currentLang = 'es' } = Astro.props;
const data = portfolioData[currentLang];
const isEn = currentLang === 'en';

const kLabel = isEn ? "Core Technical Competencies & Tooling" : "Competencias Técnicas & Herramientas";
const kTitle = isEn ? "Systems, Infrastructure & Software Stack" : "Stack de Infraestructura, Redes & Automatización";
const kSub = isEn
  ? "Disciplined engineering stack balancing enterprise systems administration, virtualization topology, and autonomous AI pipelines."
  : "Stack disciplinado que equilibra administración de servidores empresariales, topología de redes y canalizaciones de IA agéntica.";
---

<section id="stack" class="relative scroll-mt-24 py-12 border-b border-slate-800/80 space-y-8">
  <!-- Section Kicker Header -->
  <div class="border-b border-slate-800/80 pb-6">
    <span class="text-cyan-400 font-mono text-xs uppercase tracking-wider">{data.stack.label}</span>
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white mt-1 tracking-tight">{kTitle}</h2>
    <p class="text-slate-400 text-sm mt-1.5 max-w-xl leading-relaxed">
      {kSub}
    </p>
  </div>

  <!-- Tech Groups Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    {data.stack.groups.map((group, index) => (
      <div class="glass-card rounded-2xl p-6 transition-all duration-300 hover:border-cyan-500/40 hover:shadow-lg hover:shadow-cyan-500/5 flex flex-col justify-between">
        <div>
          <!-- Group Title -->
          <div class="flex items-center justify-between pb-4 border-b border-slate-800/80">
            <h3 class="font-mono text-xs font-bold tracking-wider text-cyan-400 uppercase">
              {group.title}
            </h3>
            <span class="font-mono text-xs text-slate-500">
              0{index + 1}
            </span>
          </div>

          <!-- Items List -->
          <ul class="mt-4 space-y-2.5">
            {group.items.map((item) => (
              <li class="flex items-center justify-between text-xs sm:text-sm text-slate-200 hover:text-cyan-300 transition-colors">
                <div class="flex items-center gap-2.5">
                  <span class="size-1.5 rounded-full bg-cyan-400/70"></span>
                  <span class="font-medium">{item.name}</span>
                </div>
                <span class="font-mono text-[10px] text-slate-500 uppercase">Verified</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    ))}
  </div>
</section>
